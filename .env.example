# ==========================================
# APEX DIGITAL BANKING - ENVIRONMENT CONFIG
# ==========================================

# Neon PostgreSQL Database Connection String
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_password@ep-apex-bank.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Authentication secret for signing session tokens (min 32 characters)
AUTH_SECRET="apex_super_secure_auth_secret_token_change_in_production_2026_xyz"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Banking Node Environment
NODE_ENV="development"
